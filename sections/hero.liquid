<div class="hero full-width">
  {% if section.settings.image != blank %}
    {% liquid
      assign focal_point = section.settings.image_focal_point | default: 'center'
      assign image_style = 'object-position: center ' | append: focal_point
    %}
    {{
      section.settings.image
      | image_url: width: 2752
      | image_tag: widths: '750,1100,1500,2000,2752', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'hero__image', style: image_style
    }}
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image hero__image--placeholder' }}
  {% endif %}
  <div class="hero__scrim"></div>

  <div class="hero__content">
    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hero__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 560px;
    overflow: hidden;
    text-align: center;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__image--placeholder {
    color: var(--color-surface-container-highest);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.2);
  }

  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 720px;
    padding: 0 24px;
  }

  .hero__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 36px;
    line-height: 44px;
    letter-spacing: 0.02em;
    color: var(--color-on-primary);
    margin: 0;
  }

  .hero__subheading {
    font-family: var(--font-primary--family);
    font-size: 16px;
    color: var(--color-on-primary);
    margin: 0;
  }

  .hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border: 1.5px solid transparent;
    border-radius: var(--radius-full);
    padding: 12px 24px;
    font-family: var(--font-primary--family);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .hero__button:hover {
    background-color: var(--color-on-primary);
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  @media screen and (max-width: 749px) {
    .hero {
      min-height: 420px;
    }
    .hero__heading {
      font-size: 28px;
      line-height: 34px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "image_focal_point",
      "label": "Background image vertical focal point",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium matcha for the modern wellness lifestyle"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Crafted for quality and purity. Our matcha brings nature's goodness to your table, perfect for mindful moments and shared experiences."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
