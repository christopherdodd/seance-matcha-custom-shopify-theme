<div class="collection-banner full-width">
  {% if section.settings.image != blank %}
    {{
      section.settings.image
      | image_url: width: 1440
      | image_tag: widths: '750,1100,1440', sizes: '100vw', loading: 'eager', class: 'collection-banner__image'
    }}
  {% elsif collection.image %}
    {{
      collection.image
      | image_url: width: 1440
      | image_tag: widths: '750,1100,1440', sizes: '100vw', loading: 'eager', class: 'collection-banner__image'
    }}
  {% else %}
    {{ 'collection-1' | placeholder_svg_tag: 'collection-banner__image collection-banner__image--placeholder' }}
  {% endif %}
  <div class="collection-banner__scrim"></div>
  <h1 class="collection-banner__heading">{{ section.settings.heading | default: collection.title }}</h1>
</div>

{% stylesheet %}
  .collection-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 320px;
    overflow: hidden;
  }
  .collection-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .collection-banner__image--placeholder {
    color: var(--color-surface-container-highest);
  }
  .collection-banner__scrim {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.2);
  }
  .collection-banner__heading {
    position: relative;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 36px;
    line-height: 44px;
    letter-spacing: 0.02em;
    color: var(--color-on-primary);
    margin: 0;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .collection-banner {
      height: 200px;
    }
    .collection-banner__heading {
      font-size: 28px;
      line-height: 34px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the collection's title"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Defaults to the collection's image"
    }
  ]
}
{% endschema %}
