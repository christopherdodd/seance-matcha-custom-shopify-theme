<dialog id="cart-drawer" class="cart-drawer" scroll-lock aria-label="{{ 'cart.title' | t }}" data-change-url="{{ routes.cart_change_url }}.js" data-shop-currency="{{ cart.currency.iso_code }}">
  <div class="cart-drawer__panel">
    <div id="cart-drawer-body" data-item-count="{{ cart.item_count }}">
      <div class="cart-drawer__header">
        <p class="cart-drawer__heading">{{ 'cart.title' | t }} ({{ cart.item_count }})</p>
        <button type="button" class="cart-drawer__close" data-drawer-close aria-label="{{ 'general.close' | t }}">
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>
      </div>

      {% if cart.item_count > 0 %}
        <ul class="cart-drawer__lines" role="list" data-lines>
          {% for line_item in cart.items %}
            {% render 'cart-line-item', line_item: line_item %}
          {% endfor %}
        </ul>

        <div class="cart-drawer__summary">
          <div class="cart-drawer__subtotal">
            <p>{{ 'cart.subtotal' | t }}</p>
            <p data-cart-subtotal>{{ cart.total_price | money }}</p>
          </div>
          <a href="{{ routes.cart_url }}/checkout" class="cart-drawer__checkout">
            {{ 'cart.checkout' | t }}
          </a>
        </div>
      {% else %}
        <div class="cart-drawer__empty">
          <p>{{ 'cart.empty' | t }}</p>
          <button type="button" class="cart-drawer__continue" data-drawer-close>
            {{ 'cart.continue_shopping' | t }}
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</dialog>

<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

{% stylesheet %}
  .cart-drawer {
    border: none;
    padding: 0;
    margin: 0;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    background: transparent;
  }
  .cart-drawer::backdrop {
    background-color: rgba(46, 42, 31, 0.4);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .cart-drawer.is-open::backdrop {
    opacity: 1;
  }
  .cart-drawer__panel {
    background-color: var(--color-surface-bright);
    width: 420px;
    max-width: 100%;
    height: 100%;
    margin-left: auto;
    padding: 28px;
    border-radius: 20px 0 0 20px;
    box-shadow: var(--shadow-overlay);
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  .cart-drawer.is-open .cart-drawer__panel {
    transform: translateX(0);
  }
  #cart-drawer-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: 100%;
  }
  .cart-drawer[data-loading] #cart-drawer-body {
    opacity: 0.6;
    pointer-events: none;
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cart-drawer__heading {
    font-family: var(--font-primary--family);
    font-weight: 600;
    font-size: 18px;
    color: var(--color-on-surface);
    margin: 0;
  }
  .cart-drawer__close {
    background: none;
    border: none;
    padding: 0;
    display: flex;
    cursor: pointer;
    color: var(--color-on-surface-variant);
    transition: color 0.15s ease;
  }
  .cart-drawer__close:hover {
    color: var(--color-on-surface);
  }
  .cart-drawer__close svg {
    width: 18px;
    height: 18px;
  }

  .cart-drawer__lines {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    overflow-y: auto;
    flex: 1 0 0;
  }

  .cart-drawer__summary {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--color-outline-variant);
  }
  .cart-drawer__subtotal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-primary--family);
    font-size: 14px;
    color: var(--color-on-surface);
  }
  .cart-drawer__subtotal p:last-child {
    font-weight: 600;
  }
  .cart-drawer__checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border: 1.5px solid transparent;
    border-radius: var(--radius-full);
    padding: 14px 24px;
    font-family: var(--font-primary--family);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .cart-drawer__checkout:hover {
    background-color: var(--color-on-primary);
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .cart-drawer__empty {
    flex: 1 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .cart-drawer__empty p {
    font-family: var(--font-primary--family);
    font-weight: 600;
    font-size: 14px;
    color: var(--color-on-surface);
    margin: 0;
  }
  .cart-drawer__continue {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-full);
    padding: 10px 20px;
    font-family: var(--font-primary--family);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: none;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .cart-drawer__continue:hover {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
  }

  @media screen and (max-width: 749px) {
    .cart-drawer__panel {
      width: 100%;
      border-radius: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
