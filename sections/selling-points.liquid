<div class="selling-points full-width">
  <div class="selling-points__container">
    {% if section.settings.heading != blank %}
      <h2 class="selling-points__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="selling-points__row">
        {% for block in section.blocks %}
          <div class="selling-points__item" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              {{ block.settings.icon | image_url: width: 128 | image_tag: widths: '64,128', loading: 'lazy', class: 'selling-points__icon' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'selling-points__icon selling-points__icon--placeholder' }}
            {% endif %}
            {% if block.settings.title != blank %}
              <p class="selling-points__item-title">{{ block.settings.title }}</p>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="selling-points__item-description">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .selling-points {
    background-color: var(--color-surface-bright);
    display: flex;
    justify-content: center;
    padding: 64px 24px;
  }

  .selling-points__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    max-width: var(--page-width);
    width: 100%;
  }

  .selling-points__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 24px;
    line-height: 36px;
    letter-spacing: 0.02em;
    color: var(--color-on-surface);
    margin: 0;
    text-align: center;
  }

  .selling-points__row {
    display: flex;
    gap: 32px;
    width: 100%;
  }

  .selling-points__item {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .selling-points__icon {
    width: 64px;
    height: 64px;
  }
  .selling-points__icon--placeholder {
    color: var(--color-outline-variant);
  }

  .selling-points__item-title {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 24px;
    line-height: 36px;
    letter-spacing: 0.02em;
    color: var(--color-on-surface);
    margin: 0;
  }

  .selling-points__item-description {
    font-family: var(--font-primary--family);
    font-size: 12px;
    color: var(--color-on-surface-variant);
    text-align: center;
    max-width: 260px;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .selling-points__row {
      flex-direction: column;
      align-items: center;
      gap: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
