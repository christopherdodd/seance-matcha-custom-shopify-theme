{% doc %}
  Renders a product card matching the Séance Matcha design system.

  @param product {product} - the product to render
{% enddoc %}

{% liquid
  assign card_product = product
  assign card_variant = card_product.selected_or_first_available_variant
  assign card_image = card_product.featured_media.preview_image | default: card_product.featured_image
%}

<div class="product-card">
  <div class="product-card__media">
    {% if card_image %}
      <a href="{{ card_product.url }}" class="product-card__media-link">
        {{
          card_image
          | image_url: width: 600
          | image_tag:
            widths: '300,600',
            sizes: '280px',
            loading: 'lazy',
            class: 'product-card__image',
            alt: card_image.alt
        }}
      </a>
    {% endif %}

    {% if card_variant.available %}
      <product-quick-add data-variant-id="{{ card_variant.id }}" data-url="{{ routes.cart_add_url }}.js">
        <button type="button" class="product-card__quick-add">
          {{ 'products.quick_add' | t }}
        </button>
      </product-quick-add>
    {% else %}
      <span class="product-card__sold-out">{{ 'products.sold_out' | t }}</span>
    {% endif %}
  </div>

  <a href="{{ card_product.url }}" class="product-card__title">{{ card_product.title }}</a>
  <span class="product-card__price">{{ card_variant.price | money }}</span>

  {% if card_product.metafields.reviews.rating.value %}
    <span class="product-card__rating">
      {{ card_product.metafields.reviews.rating.value }} ({{ card_product.metafields.reviews.rating_count.value }})
    </span>
  {% endif %}
</div>

<script src="{{ 'product-quick-add.js' | asset_url }}" defer></script>

{% stylesheet %}
  .product-card {
    background-color: var(--color-surface-bright);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-lg);
    padding: var(--spacing-card-gap);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gap-sm);
    width: 100%;
  }

  .product-card__media {
    background-color: var(--color-surface-container-highest);
    border-radius: var(--radius-md);
    aspect-ratio: 240 / 260;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 10px;
    position: relative;
    overflow: hidden;
  }

  .product-card__media-link {
    position: absolute;
    inset: 0;
  }

  product-quick-add {
    display: block;
    width: 100%;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .product-card__quick-add,
  .product-card__sold-out {
    position: relative;
    width: 100%;
    background-color: var(--color-surface);
    border: 1px solid var(--color-on-primary);
    border-radius: var(--radius-full);
    padding: 8px;
    font-family: var(--font-primary--family);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    text-align: center;
    cursor: pointer;
    transition: opacity 0.15s ease, background-color 0.15s ease;
  }
  .product-card__quick-add:hover {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  @media (hover: hover) {
    .product-card__quick-add {
      opacity: 0;
      visibility: hidden;
    }
    .product-card:hover .product-card__quick-add,
    .product-card:focus-within .product-card__quick-add {
      opacity: 1;
      visibility: visible;
    }
  }
  .product-card__sold-out {
    color: var(--color-on-surface-variant);
    cursor: default;
  }

  .product-card__title {
    font-family: var(--font-primary--family);
    font-weight: 600;
    font-size: 16px;
    color: var(--color-on-surface);
    text-decoration: none;
  }
  .product-card__title:hover {
    text-decoration: underline;
  }

  .product-card__price {
    font-family: var(--font-primary--family);
    font-weight: 600;
    font-size: 14px;
    color: var(--color-on-surface);
  }

  .product-card__rating {
    font-family: var(--font-primary--family);
    font-size: 13px;
    color: var(--color-on-surface-variant);
  }
{% endstylesheet %}
